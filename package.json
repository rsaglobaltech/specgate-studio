{
  "name": "specgate-studio",
  "private": true,
  "version": "0.0.0",
  "description": "An IDE for spec-driven development, with specgate underneath",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/protocol packages/host",
    "test": "npm run build && node --test \"packages/*/dist/test/**/*.test.js\"",
    "arch": "depcruise packages --config .dependency-cruiser.cjs",
    "clean": "tsc -b --clean packages/core packages/protocol packages/host",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"packages/*/test/**/*.ts\""
  },
  "devDependencies": {
    "@rsaglobaltech/specgate": "^0.31.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "dependency-cruiser": "^16.10.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
